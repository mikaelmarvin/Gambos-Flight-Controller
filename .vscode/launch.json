{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug gambos-pcb (J-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/software/project/build/gambos-pcb/gambos.elf",
      "device": "STM32F446RE",
      "interface": "swd",
      "svdFile": "${workspaceFolder}/software/STM32F446.svd",
      "runToEntryPoint": "main"
    },
    {
      "name": "Attach gambos-pcb (J-Link)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "jlink",
      "executable": "${workspaceFolder}/software/project/build/gambos-pcb/gambos.elf",
      "device": "STM32F446RE",
      "interface": "swd",
      "svdFile": "${workspaceFolder}/software/STM32F446.svd"
    }
  ]
}
