# Active board: compile_commands.json in this directory (symlink to build/gambos-pcb/).
# Restart clangd after rebuilding.

CompileFlags:
  CompilationDatabase: .

Index:
  Background: Build

---
CompileFlags:
  Add:
    - -isystem
    - /usr/lib/gcc/arm-none-eabi/10.3.1/include
    - -isystem
    - /usr/lib/gcc/arm-none-eabi/10.3.1/include-fixed
    - -isystem
    - /usr/include/newlib
    - -isystem
    - /usr/lib/arm-none-eabi/include/c++/10.3.1
    - -isystem
    - /usr/lib/arm-none-eabi/include/c++/10.3.1/arm-none-eabi
    - -isystem
    - /usr/lib/arm-none-eabi/include/c++/10.3.1/backward

---
InlayHints:
  ParameterNames: No
