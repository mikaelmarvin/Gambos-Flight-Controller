{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchain-gambos-pcb.cmake",
            "cacheVariables": {}
        },
        {
            "name": "gambos-pcb",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gambos-pcb",
            "configurePreset": "gambos-pcb"
        }
    ]
}
